{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.py": {
      "includeFiles": "{core/**,server.py,dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__vpath=:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__vpath=health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
